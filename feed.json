---
layout: null
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": "{{ site.title | escape }} - Blog",
  "home_page_url": "{{ site.url }}/blog/",
  "feed_url": "{{ '/feed.json' | prepend: site.url }}",
  "items": [
    {% for post in site.posts limit:10 %}
    {
      "id": "{{ post.url | prepend: site.url }}",
      "url": "{{ post.url | prepend: site.url }}",
      "title": {{ post.title | jsonify }},
      "summary": {{ post.excerpt | strip_html | normalize_whitespace | jsonify }},
      "date_published": "{{ post.date | date_to_xmlschema }}"
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}